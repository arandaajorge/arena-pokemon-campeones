      padding:10px;
      border-radius:10px;
      font-weight:800;
      margin:8px 0;
      background:#29354b;
    }

    .ab-myturn {
      background:#174b36;
      color:#86efac;
    }

    .ab-grid {
      display:flex;
      flex-direction:column;
